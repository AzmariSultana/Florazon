# Florazon API configuration
# Copy this file to backend/.env and replace the placeholder values.
# Never commit backend/.env: it contains secrets.

# Port the API listens on (optional, defaults to 4000)
PORT=4000

# MongoDB connection string (required)
# MongoDB Atlas: Cluster > Connect > Drivers. The "florazon" database is selected automatically,
# so do not add a database name to the end of the string.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net

# Secret used to sign login tokens (required)
# Use a long random string, for example the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Admin panel login (required)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Cloudinary account used to store product images (required for adding products)
# Cloudinary Console > Dashboard > API Keys
CLOUDINARY_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_SECRET_KEY=your-api-secret
